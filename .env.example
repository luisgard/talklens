# Copy to .env. Everything here is optional: with no keys TalkLens runs fully offline on the local caption model.
# Keys stay on the laptop. Only audio, slide images and transcript text are sent to the provider you pick.

# OPENAI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Captions: openai (default, streaming) | groq (1-2 s blocks) | local
# Ai__TranscriptionProvider=openai

# Answers and translation: auto | openai | anthropic | groq | none
# Ai__ChatProvider=auto
# Ai__ChatModel=

# Slide reading: auto | openai | anthropic | none
# Ai__VisionProvider=auto
# Ai__VisionModel=

# Search by meaning: auto | openai | none. Sends transcript text and search queries to OpenAI. Without it, search uses words alone.
# Ai__EmbeddingProvider=auto
# Search uses Elasticsearch when it answers here, and SQLite otherwise. Empty turns it off. See elasticsearch/docker-compose.yml.
# Ai__ElasticsearchUrl=http://127.0.0.1:9200

# Cloud voice for "Listen in my language": openai | none. Without it, phones use their own voice, free and offline.
# Ai__VoiceProvider=none

# Luma: imports guests and event details. The API needs a Luma Plus plan; without it, use Luma's CSV export.
# LUMA_API_KEY=

# Mail for tickets and contact lists. Without it, tickets stay on the phone that registered.
# Mail__Host=
# Mail__Port=587
# Mail__User=
# Mail__From=
# Mail__UseSsl=true
# MAIL_PASSWORD=

# Event Wi-Fi, shown as a QR code on the operator panel.
# Network__WifiSsid=
# Network__WifiPassword=

# Attendee port. Use 80 for the captive portal (docs/NETWORK.md).
# Network__HttpPort=8080
# Network__HttpsPort=8443
# Address printed in the QR codes. Empty means auto-detect; the operator panel can also change it.
# Network__PublicHost=
